# rat-c2-server Render Environment Variables
# Copy this to .env or set directly in Render dashboard

# Server configuration
PORT=8080
DATABASE_PATH=./data/ratc2.db
server.api_addr=0.0.0.0:8080
server.ws_addr=0.0.0.0:8081
server.tls_enabled=false
logging.level=info

# Optional: Render specific
RENDER=true